        float3 xformOp:translate = (-0.0039935224, 0.17226975, -3.1823983e-8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Tractor_Beam" (
            active = false
        )
        {
        }
    }
}

